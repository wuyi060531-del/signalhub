# Copy only if needed. The local manager derives DB_URL/DATABASE_URL.
# Set a unique nonempty password for a NEW local cluster; leave blank only
# for an existing local trust cluster. Keep this populated copy out of Git.
DB_USER=signalhub
DB_PASSWORD=
# Optional: separately initialized Compose cluster. Required by docker compose.
# SIGNALHUB_COMPOSE_DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
PORT=8080
GITHUB_TOKEN=
AI_PROVIDER=disabled
AI_PAID_AUTHORIZED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_MONTHLY_BUDGET_USD=0
AI_MAX_CALLS_PER_MONTH=0
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0

# Optional offline English→Chinese reference translation; prepare with scripts/setup_local_translation.py.
LOCAL_TRANSLATION_ENABLED=false
